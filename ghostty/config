# this is a comment

background-opacity = 0.9
unfocused-split-opacity = 0.4

font-family = "JetBrains Mono Medium"
font-style-bold = true
font-size = 10

window-decoration = false
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true
window-vsync = true
window-decoration = false
window-save-state = always

gtk-tabs-location = bottom
adw-toolbar-style = flat
gtk-wide-tabs = false

quick-terminal-animation-duration = 1

clipboard-paste-protection = true

auto-update = check
auto-update-channel = stable

# Keybinds

#config reload
keybind = ctrl+shift+r=reload_config

#UI Controls

keybind = ctrl+t=new_tab

#splits

keybind = ctrl+n>r=new_split:right
keybind = ctrl+n>d=new_split:down
keybind = ctrl+n>u=new_split:up
keybind = ctrl+n>l=new_split:left

keybind = ctrl+s>r=goto_split:right
keybind = ctrl+s>d=goto_split:down
keybind = ctrl+s>u=goto_split:up
keybind = ctrl+s>l=goto_split:left


keybind = ctrl+shift+s>r=resize_split:right,20
keybind = ctrl+shift+s>d=resize_split:down,20
keybind = ctrl+shift+s>u=resize_split:up,20
keybind = ctrl+shift+s>l=resize_split:left,20

